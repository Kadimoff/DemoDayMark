# HTTP port the Node server listens on (Caddy/nginx proxy to it)
PORT=3000

# Admin (coordinator) account — created on first start from these values.
# Change ADMIN_PASSWORD before the event; after the account exists, changing it here has no effect.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Long random string used to sign session cookies: openssl rand -hex 32
SESSION_SECRET=

# Public URL(s) of the app, comma separated. State-changing requests and websockets
# from any other origin are rejected. Leave empty to allow same-host requests only (LAN use).
ORIGIN=https://jury.example.az

# Secure cookies are enabled automatically when ORIGIN is https. Override only for testing.
# COOKIE_SECURE=false

# Show a juror their own weighted total (false = jurors only see per-criterion scores)
SHOW_JUROR_TOTAL=false

# Teams with fewer complete juror scores than this get an "eksik" flag in the ranking
MIN_JURORS_FOR_RANK=3

# Where the SQLite database lives
DATA_DIR=./data
